# Puerto en el que escucha la API
PORT=3000

# Orígenes permitidos por CORS (separados por coma). El del Angular en desarrollo por defecto.
CORS_ORIGIN=http://localhost:4200

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# DB_TYPE=sqlite  -> no requiere nada más instalado, guarda todo en un archivo
#                    local (DB_SQLITE_PATH). Ideal para levantar el backend
#                    rápido sin depender de Docker ni de una base externa.
# DB_TYPE=mysql   -> se conecta a un MySQL real: el de Docker en tu máquina,
#                    el de la EC2 de test, o más adelante RDS. Es el mismo
#                    driver (mysql2) en los tres casos.
DB_TYPE=sqlite

# --- Config para DB_TYPE=sqlite ---
DB_SQLITE_PATH=./data/gestion-app.sqlite

# --- Config para DB_TYPE=mysql (tu MySQL de Docker en local, la EC2, o RDS más adelante) ---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=gestion_app

# Crea/actualiza las tablas automáticamente a partir de las entidades.
# Pensado para desarrollo; para producción conviene pasar a migraciones (ver README).
DB_SYNCHRONIZE=true

# Loguea cada query SQL ejecutada (útil para debug, ruidoso en uso normal).
DB_LOGGING=false
